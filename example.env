# SystemC Drovex (Java) — copy to .env and fill in what you use.

## Bots
DISCORD_BOT_TOKEN=
STOAT_BOT_TOKEN=
ALLOWED_CHANNEL_IDS=
STOAT_ALLOWED_CHANNEL_IDS=
BOT_MODE=WAKEWORD            # WAKEWORD / MENTION / EVERYTHING
STOAT_BOT_MODE=WAKEWORD
WAKE_WORD=hey claw
STOAT_WAKE_WORD=hey claw

## Model backend (pick one)
# 1) local Ollama
OLLAMA_HOST=http://localhost:11434
AGENT_MODEL=qwen2.5:0.5b
# 2) Ollama Cloud
# OLLAMA_MODE=cloud
# OLLAMA_API_KEY=
# 3) Anthropic
# AGENT_PROVIDER=anthropic
# AGENT_MODEL=claude-sonnet-4-6
# ANTHROPIC_API_KEY=

## Tools / approvals
AGENT_WORKDIR=
AGENT_ALLOW_ELEVATED=1
APPROVAL_MODE=ask            # ask / approve_all / deny_all
# APPROVAL_COMMANDS=rm,sudo,apt

## Personalization
AGENT_NAME=SystemC
AGENT_GENDER=
AGENT_PRONOUNS=
AGENT_CASUAL_TONE=0
# AGENT_SYSTEM_PROMPT=       # leave unset for the built-in default

## Subagents
SUBAGENTS=on
# SUBAGENT_MODEL=qwen2.5:0.5b

## Integrations (java SPI jars + python-compat .py files in integrations/)
# INTEGRATIONS=dice,notes     # comma list, or all; empty = none
# PY_COMPAT=auto             # auto/on/off — bridge python *.py integrations
# INTEGRATION_TIMEOUT=180    # max seconds per python tool call

## Web console
SYSTEMC_WEBSITE=1
WEBUI_PORT=7842
# SYSTEMC_API_TOKEN=         # enables /api/v1/* endpoints
